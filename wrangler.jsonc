{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "ruang-sunyi-ai-hq",
  "main": "src/index.js",
  "compatibility_date": "2026-09-25",
  "observability": { "enabled": true },
  "triggers": {
    "crons": [
      "0 0 * * *",
      "0 11 * * *"
    ]
  },
  "vars": {
    "DEFAULT_MODEL": "openrouter/free",
    "STRONG_MODEL": "openai/gpt-5-mini",
    "OWNER_TIMEZONE": "Asia/Jakarta",
    "MAX_AUTONOMOUS_LEVEL": "2",
    "SUPABASE_URL": "https://zvrnonohcppcamgokayn.supabase.co"
  }
}